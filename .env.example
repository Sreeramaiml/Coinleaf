# Optional secrets and overrides for the Personal Financial Assistant (Coinleaf).
#
# The preferred place for secrets is the macOS Keychain:
#     Coinleaf config set-api-key            # stores the Gemini key (the default provider)
# Use this file only if you cannot use the Keychain.
#
# To use it: copy to ".env" in the project folder, fill in the values, then run
#     chmod 600 .env
# Coinleaf refuses to read a .env file that other users can read.
# Never commit .env. It is listed in .gitignore.
#
# Never put statement passwords, account numbers, or the database key in this file.

# Gemini API key (default provider), used only when llm_mode = "cloud".
# Use a key from a billing-enabled Google Cloud project (paid tier): on the free tier Google
# may use and human-review what you send. See PRIVACY.md.
# GEMINI_API_KEY=AIza-your-key

# Anthropic API key, only if you set provider = "anthropic" under [llm] in config.toml.
# ANTHROPIC_API_KEY=sk-ant-your-key

# Optional: path to the config file, if it is not at
# ~/Library/Application Support/finassist/config.toml
# FINASSIST_CONFIG=/Users/you/Library/Application Support/finassist/config.toml

# Optional: override the LLM mode from the config file for one run.
# cloud = the configured provider's API, with redaction · local = local model only · off = no LLM
# FINASSIST_LLM_MODE=off
